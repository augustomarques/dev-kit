[run]
branch = True
parallel = True
patch = subprocess
source =
    plugins/dev-kit/skills/dev-kit-to-issues/scripts
    plugins/dev-kit/skills/dev-kit-github/scripts
    plugins/dev-kit/skills/dev-kit-develop/scripts
    plugins/dev-kit/skills/dev-kit-setup/scripts
    plugins/dev-kit/skills/dev-kit-git/scripts

[report]
fail_under = 81
show_missing = True
skip_covered = True
